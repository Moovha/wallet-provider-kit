{
  "name": "@moovha/wallet-provider-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider-hosted wallet authorization, onboarding and signing adapters for Node.js",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "packageManager": "npm@11.11.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./onboarding": {
      "types": "./dist/onboarding/index.d.ts",
      "import": "./dist/onboarding/index.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "import": "./dist/identity/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    },
    "./cdp": {
      "types": "./dist/providers/cdp.d.ts",
      "import": "./dist/providers/cdp.js"
    },
    "./ows": {
      "types": "./dist/providers/ows.d.ts",
      "import": "./dist/providers/ows.js"
    },
    "./openzeppelin-relayer": {
      "types": "./dist/providers/openzeppelin-relayer.d.ts",
      "import": "./dist/providers/openzeppelin-relayer.js"
    },
    "./spec/provider-api.json": "./spec/provider-api.json",
    "./spec/orchestration-draft.json": "./spec/orchestration-draft.json"
  },
  "files": [
    "dist",
    "spec",
    "docs",
    "examples",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:spec": "node --import tsx scripts/check-spec.mjs",
    "generate:spec": "node --import tsx scripts/check-spec.mjs --write",
    "check:secrets": "secretlint \"**/*\"",
    "sbom": "npm sbom --sbom-format cyclonedx --omit=dev",
    "verify": "npm run typecheck && npm run test && npm run check:spec && npm run check:docs && npm run format:check && npm run check:secrets",
    "pack:local": "npm run build && npm pack --ignore-scripts",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "generate:docs": "node scripts/api-docs.mjs --write",
    "check:docs": "node scripts/api-docs.mjs",
    "example:provider": "npm run build && node examples/provider-flow/run.mjs"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "1.58.0",
    "ethers": "6.17.0",
    "fastify": "5.12.7",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "jose": "6.2.12",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "openid-client": "6.8.8"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vitest": "5.0.4",
    "prettier": "3.9.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "secretlint": "13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@open-wallet-standard/core": "1.4.3"
  },
  "peerDependencies": {
    "@open-wallet-standard/core": "1.4.3"
  },
  "peerDependenciesMeta": {
    "@open-wallet-standard/core": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moovha/wallet-provider-kit.git"
  },
  "homepage": "https://github.com/Moovha/wallet-provider-kit#readme",
  "bugs": {
    "url": "https://github.com/Moovha/wallet-provider-kit/issues"
  },
  "keywords": [
    "wallet",
    "custody",
    "onboarding",
    "oauth",
    "eip-712",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wallet-provider-kit": "./dist/main.js"
  }
}
