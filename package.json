{
  "name": "@moovha/wallet-provider-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenAPI wallet provider service and conformance kit with pluggable signing backends",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "packageManager": "npm@11.11.1",
  "exports": {
    ".": "./dist/index.js",
    "./cdp": "./dist/providers/cdp.js",
    "./ows": "./dist/providers/ows.js"
  },
  "files": [
    "dist",
    "spec",
    "docs",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:spec": "node --import tsx scripts/check-spec.mjs",
    "generate:spec": "node --import tsx scripts/check-spec.mjs --write",
    "check:secrets": "secretlint \"**/*\"",
    "sbom": "npm sbom --sbom-format cyclonedx --omit=dev",
    "verify": "npm run typecheck && npm run test && npm run check:spec && npm run format:check && npm run check:secrets"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "1.58.0",
    "ethers": "6.17.0",
    "fastify": "5.12.7",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "jose": "6.2.12",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vitest": "4.1.11",
    "prettier": "3.6.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "secretlint": "13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@open-wallet-standard/core": "1.4.3"
  },
  "peerDependencies": {
    "@open-wallet-standard/core": "1.4.3"
  },
  "peerDependenciesMeta": {
    "@open-wallet-standard/core": {
      "optional": true
    }
  }
}
