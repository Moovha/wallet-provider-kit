# Local examples only. No credentials are needed for npm start.
HOST=127.0.0.1
PORT=8080
API_DOCUMENTATION=true
# Optional existing OAuth issuer; all three must be supplied together.
# OAUTH_ISSUER=https://identity.example.test
# OAUTH_AUDIENCE=wallet-provider-service
# OAUTH_JWKS_URL=https://identity.example.test/jwks
# Optional existing HTTPS collector base URL.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.test
# Required for the optional local Compose Grafana profile; set privately in .env.
GRAFANA_ADMIN_PASSWORD=
# CDP is library-only, never automatically activated by these variables.
# WALLET_SERVICE_MODE=provider
# WALLET_BACKEND=cdp
# WALLET_CDP_API_KEY_ID=<key-id>
# WALLET_CDP_API_KEY_SECRET=<secret-store-value>
# WALLET_CDP_WALLET_SECRET=<secret-store-value>
