{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moovha.com/wallet-provider-kit/provider-config-v1.schema.json",
  "title": "Wallet Provider Kit deployment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configVersion",
    "profile",
    "policy",
    "oauth",
    "ownerLogin",
    "reviewers",
    "identity",
    "backend",
    "storage",
    "activation"
  ],
  "properties": {
    "configVersion": {
      "const": 1
    },
    "profile": {
      "const": "provider-service-v1"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "provider", "applications"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "origin", "privacyUrl"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "origin": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https://"
            },
            "privacyUrl": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https://"
            }
          }
        },
        "applications": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["issuer", "clientId", "name", "permissions"],
            "properties": {
              "issuer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^https://"
              },
              "clientId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "enabled": {
                "type": "boolean"
              },
              "permissions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "account:read",
                    "operations:request",
                    "transfers:request"
                  ]
                }
              },
              "funding": {
                "type": "object",
                "additionalProperties": false,
                "required": ["agreement", "monthlyLimitMinor"],
                "properties": {
                  "agreement": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "monthlyLimitMinor": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              }
            }
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAgeDays"],
          "properties": {
            "records": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requiredFields"],
              "properties": {
                "requiredFields": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  }
                }
              }
            },
            "maxAgeDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            }
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAgeDays"],
          "properties": {
            "maxAgeDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            }
          }
        }
      }
    },
    "oauth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "audience", "jwksUrl"],
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://"
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "jwksUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://"
        }
      }
    },
    "ownerLogin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "clientId", "clientSecret"],
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://"
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "clientSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["env"],
          "properties": {
            "env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
            }
          }
        },
        "idTokenAlgorithm": {
          "enum": ["RS256", "ES256"]
        }
      }
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "didit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["apiKey", "workflowId"],
          "properties": {
            "apiKey": {
              "type": "object",
              "additionalProperties": false,
              "required": ["env"],
              "properties": {
                "env": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                }
              }
            },
            "workflowId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "importPrice": {
              "type": "object",
              "additionalProperties": false,
              "required": ["maximumMinor", "termsReference"],
              "properties": {
                "maximumMinor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "termsReference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "verificationPrice": {
              "type": "object",
              "additionalProperties": false,
              "required": ["maximumMinor", "termsReference"],
              "properties": {
                "maximumMinor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "termsReference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        },
        "sumsub": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appToken",
            "secretKey",
            "levelName",
            "reusableKycShareEnabled"
          ],
          "properties": {
            "appToken": {
              "type": "object",
              "additionalProperties": false,
              "required": ["env"],
              "properties": {
                "env": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                }
              }
            },
            "secretKey": {
              "type": "object",
              "additionalProperties": false,
              "required": ["env"],
              "properties": {
                "env": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                }
              }
            },
            "levelName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "reusableKycShareEnabled": {
              "const": true
            },
            "importPrice": {
              "type": "object",
              "additionalProperties": false,
              "required": ["maximumMinor", "termsReference"],
              "properties": {
                "maximumMinor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "termsReference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "verificationPrice": {
              "type": "object",
              "additionalProperties": false,
              "required": ["maximumMinor", "termsReference"],
              "properties": {
                "maximumMinor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "termsReference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        }
      },
      "minProperties": 0
    },
    "backend": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "apiKeyId",
            "apiKeySecret",
            "walletSecret",
            "binding"
          ],
          "properties": {
            "kind": {
              "const": "cdp"
            },
            "apiKeyId": {
              "type": "object",
              "additionalProperties": false,
              "required": ["env"],
              "properties": {
                "env": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                }
              }
            },
            "apiKeySecret": {
              "type": "object",
              "additionalProperties": false,
              "required": ["env"],
              "properties": {
                "env": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                }
              }
            },
            "walletSecret": {
              "type": "object",
              "additionalProperties": false,
              "required": ["env"],
              "properties": {
                "env": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                }
              }
            },
            "binding": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "binding", "vaultDirectory", "passphrase"],
          "properties": {
            "kind": {
              "const": "ows"
            },
            "binding": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "vaultDirectory": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "passphrase": {
              "type": "object",
              "additionalProperties": false,
              "required": ["env"],
              "properties": {
                "env": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "binding", "url", "apiKey", "signers"],
          "properties": {
            "kind": {
              "const": "openzeppelin-relayer"
            },
            "binding": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "url": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "apiKey": {
              "type": "object",
              "additionalProperties": false,
              "required": ["env"],
              "properties": {
                "env": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                }
              }
            },
            "signers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "relayerId",
                  "signerId",
                  "address",
                  "bindingRevision"
                ],
                "properties": {
                  "relayerId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                  },
                  "signerId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                  },
                  "address": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "bindingRevision": {
                    "const": "1"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "module", "binding"],
          "properties": {
            "kind": {
              "const": "custom"
            },
            "module": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "options": {
              "type": "object"
            },
            "binding": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "directory"],
      "properties": {
        "kind": {
          "const": "sqlite"
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backendAcceptance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "recoveryAcceptance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tokenAcceptance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "financial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "token",
        "recipients",
        "maximumAmount",
        "lifetimeAmount",
        "maxValiditySeconds"
      ],
      "properties": {
        "profile": {
          "const": "provider-authorized-erc3009-v1"
        },
        "token": {
          "type": "object",
          "additionalProperties": false,
          "required": ["address", "name", "version", "symbol", "decimals"],
          "properties": {
            "address": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "symbol": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{1,12}$"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 36
            }
          }
        },
        "recipients": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          }
        },
        "maximumAmount": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,77}$"
        },
        "lifetimeAmount": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,77}$"
        },
        "maxValiditySeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "host": {
          "type": "string",
          "enum": ["127.0.0.1", "0.0.0.0", "::1", "::"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "documentation": {
          "type": "boolean"
        }
      }
    },
    "apiExplorer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operators", "clients"],
      "properties": {
        "operators": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "clients": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["clientId", "clientSecret", "scopes"],
            "properties": {
              "clientId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "clientSecret": {
                "type": "object",
                "additionalProperties": false,
                "required": ["env"],
                "properties": {
                  "env": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                  }
                }
              },
              "scopes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 7,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "wallet:access",
                    "wallet:access:read",
                    "wallet:account:read",
                    "wallet:provision",
                    "wallet:actions",
                    "wallet:actions:read",
                    "wallet:sign"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
