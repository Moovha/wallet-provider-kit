              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["profile", "status", "configured"],
                  "additionalProperties": false,
                  "properties": {
                    "profile": {
                      "type": "string",
                      "enum": ["provider-signing-preview"]
                    },
                    "status": { "type": "string", "enum": ["experimental"] },
                    "configured": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
