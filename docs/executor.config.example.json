{
  "configVersion": 1,
  "profile": "execution-service-v1",
  "origin": "https://executor.example.com",
  "binding": "your-execution-service",
  "storage": {
    "kind": "sqlite",
    "directory": ".executor-data"
  },
  "signing": {
    "id": "executor-2026",
    "privateKey": {
      "env": "EXECUTOR_PRIVATE_KEY"
    }
  },
  "callers": [
    {
      "origin": "https://wallet.example.com",
      "keys": [
        {
          "id": "wallet-2026",
          "publicKey": {
            "env": "WALLET_SERVICE_PUBLIC_KEY"
          }
        }
      ],
      "providers": ["application-sponsor"]
    }
  ],
  "providers": [
    {
      "id": "application-sponsor",
      "revision": "1",
      "kind": "openzeppelin-relayer",
      "relayer": {
        "url": "https://relayer.example.com",
        "apiKey": {
          "env": "EXECUTOR_RELAYER_API_KEY"
        }
      },
      "rpc": {
        "endpoints": [
          {
            "env": "EXECUTOR_RPC_PRIMARY_URL"
          },
          {
            "env": "EXECUTOR_RPC_SECONDARY_URL"
          }
        ],
        "genesisHash": "0x1111111111111111111111111111111111111111111111111111111111111111",
        "tokenCodeHash": "0x2222222222222222222222222222222222222222222222222222222222222222"
      },
      "token": {
        "address": "0x1111111111111111111111111111111111111111",
        "name": "Example Token",
        "version": "1",
        "symbol": "TEST",
        "decimals": 6
      },
      "sponsors": [
        {
          "clientId": "your-registered-application-client",
          "accountId": "10000000-0000-4000-8000-000000000001",
          "binding": {
            "relayerId": "your-sponsor-relayer",
            "signerId": "your-sponsor-signer",
            "address": "0x3333333333333333333333333333333333333333",
            "bindingRevision": "1"
          },
          "fundingAgreement": "your-reviewed-gas-funding-agreement",
          "gasLimit": "150000",
          "maxFeePerGas": "3000000000",
          "maxPriorityFeePerGas": "1000000000",
          "l1FeeReserveWei": "1000000000000",
          "lifetimeBudgetWei": "10000000000000000"
        }
      ]
    }
  ],
  "activation": {
    "enabled": false
  },
  "http": {
    "host": "127.0.0.1",
    "port": 8081,
    "documentation": true
  }
}
