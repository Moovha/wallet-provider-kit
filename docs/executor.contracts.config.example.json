{
  "configVersion": 1,
  "profile": "execution-service-v1",
  "origin": "https://executor.example.com",
  "binding": "your-execution-service",
  "storage": {
    "kind": "sqlite",
    "directory": ".executor-data"
  },
  "signing": {
    "id": "executor-2026",
    "privateKey": {
      "env": "EXECUTOR_PRIVATE_KEY"
    }
  },
  "callers": [
    {
      "origin": "https://wallet.example.com",
