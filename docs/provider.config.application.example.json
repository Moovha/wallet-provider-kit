{
  "configVersion": 1,
  "profile": "provider-service-v1",
  "policy": {
    "version": "1",
    "provider": {
      "name": "Your Wallet Provider",
      "origin": "https://wallet.example.com",
      "privacyUrl": "https://wallet.example.com/privacy"
    },
    "applications": [
      {
        "issuer": "https://wallet.example.com/oauth",
        "clientId": "application-1",
        "name": "Example application",
        "permissions": ["account:read", "contracts:request"],
        "assertionTrust": {
          "agreement": "replace-with-reviewed-application-agreement"
        }
      }
    ],
    "identity": {
      "maxAgeDays": 90,
      "application": {
        "requiredFields": ["country"],
        "verificationLevel": "verified"
      }
    },
    "access": {
      "mode": "application",
      "maxAgeDays": 7
    }
  },
  "oauth": {
    "issuer": "https://wallet.example.com/oauth",
    "audience": "https://wallet.example.com/api",
    "jwksUrl": "https://wallet.example.com/oauth/jwks"
  },
  "identity": {},
  "backend": {
    "kind": "ows",
    "binding": "example-application-wallets",
    "vaultDirectory": ".provider-vault",
    "passphrase": {
      "env": "OWS_OWNER_PASSPHRASE"
    }
  },
  "storage": {
    "kind": "sqlite",
    "directory": ".provider-data"
  },
  "activation": {
    "enabled": false
  },
  "http": {
    "host": "127.0.0.1",
    "port": 8080,
    "documentation": false,
    "ingress": "caddy"
  },
  "authorizationServer": {
    "signingKey": {
      "env": "WALLET_OAUTH_SIGNING_KEY"
    },
    "clients": [
      {
        "clientId": "application-1",
        "clientSecret": {
          "env": "APPLICATION_CLIENT_SECRET"
        },
        "scopes": [
          "wallet:access",
          "wallet:access:read",
          "wallet:account:read",
          "wallet:provision",
          "wallet:configuration:read",
          "wallet:configuration:propose",
          "wallet:actions",
          "wallet:sign",
          "wallet:execute",
          "wallet:execute:read"
        ]
      }
    ],
    "operatorClients": [
      {
        "clientId": "provider-operator",
        "clientSecret": {
          "env": "PROVIDER_OPERATOR_SECRET"
        }
      }
    ]
  },
  "localExecution": {
    "kind": "openzeppelin-relayer",
    "apiKey": {
      "env": "LOCAL_EXECUTION_API_KEY"
    },
    "keystorePassphrase": {
      "env": "LOCAL_EXECUTION_KEYSTORE_PASSPHRASE"
    },
    "storageKey": {
      "env": "LOCAL_EXECUTION_STORAGE_KEY"
    }
  },
  "network": "base",
  "runtimeConfiguration": {
    "authorizeContracts": true,
    "sharedApplicationSafes": true,
    "executionPool": { "safeCount": 5, "sponsorCount": 5 },
    "credentialKey": {
      "env": "APPLICATION_CREDENTIAL_STORAGE_KEY"
    },
    "operators": [
      {
        "issuer": "https://wallet.example.com/oauth",
        "clientId": "provider-operator",
        "subject": "provider-operator"
      }
    ]
  },
  "safeProvisioning": {
    "profile": "safe-1.4.1",
    "factory": {
      "address": "0x4e1DCf7AD4e460CfD30791CCC4F9c8a4f820ec67",
      "codeHash": "0x50c3cdc4074750a7a974204a716c999edd37482f907608d960b2b025ee0b3317"
    },
    "singleton": {
      "address": "0x41675C099F32341bf84BFc5382aF534df5C7461a",
      "codeHash": "0x1fe2df852ba3299d6534ef416eefa406e56ced995bca886ab7a553e6d0c5e1c4"
    },
    "proxyCodeHash": "0xd7d408ebcd99b2b70be43e20253d6d92a8ea8fab29bd3be7f55b10032331fb4c",
    "maxValiditySeconds": 300
  },
  "approvedCalls": {
    "maxValiditySeconds": 300,
    "policy": {
      "mechanism": "safe-1.4.1",
      "accounts": [],
      "multiSend": {
        "address": "0x9641d764fc13c8B624c04430C7356C1C7C8102e2",
        "codeHash": "0xecd5bd14a08c5d2122379900b2f272bdf107a7e92423c10dd5fe3254386c9939"
      },
      "maximumNativeValueWei": "0",
      "lifetimeOperations": "1000000",
      "contracts": [],
      "swaps": [],
      "vaults": []
    }
  },
  "execution": {
    "profile": "approved-evm-executor-v1",
    "local": true,
    "relayer": {
      "url": "https://bundled-execution.invalid",
      "apiKey": {
        "env": "LOCAL_EXECUTION_API_KEY"
      }
    },
    "rpc": {
      "endpoints": [],
      "genesisHash": "0xf712aa9241cc24369b143cf6dce85f0902a9731e70d66818a3a5845b296c73dd"
    },
    "sponsors": [],
    "safeQueue": {
      "maxDepthPerSafe": 32,
      "maxWaitSeconds": 300
    },
    "pollIntervalSeconds": 15,
    "maxLogRange": 10000
  }
}
