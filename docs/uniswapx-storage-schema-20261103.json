      "type": "table",
      "name": "admissions",
      "tbl_name": "admissions",
      "sql": "CREATE TABLE admissions (\n  namespace TEXT NOT NULL,\n  provider TEXT NOT NULL,\n  attempt_id TEXT NOT NULL,\n  resource_key TEXT NOT NULL,\n  request_hash TEXT NOT NULL,\n  request TEXT NOT NULL CHECK(json_valid(request)),\n  approval_id TEXT REFERENCES approvals(id),\n  context TEXT CHECK(context IS NULL OR json_valid(context)),\n  budget_id TEXT NOT NULL REFERENCES budgets(id),\n  units TEXT NOT NULL,\n  PRIMARY KEY(namespace, provider, attempt_id),\n  UNIQUE(namespace, provider, resource_key)\n) STRICT"
    },
    {
      "type": "table",
      "name": "approvals",
      "tbl_name": "approvals",
      "sql": "CREATE TABLE approvals (\n  id TEXT PRIMARY KEY NOT NULL,\n  account_id TEXT NOT NULL,\n  kind TEXT NOT NULL CHECK(kind='sign_typed_data'),\n  fingerprint TEXT NOT NULL,\n  record TEXT NOT NULL CHECK(json_valid(record)),\n  revoked INTEGER NOT NULL DEFAULT 0 CHECK(revoked IN (0,1))\n) STRICT"
    },
    {
      "type": "table",
      "name": "attempts",
      "tbl_name": "attempts",
      "sql": "CREATE TABLE attempts (\n  namespace TEXT NOT NULL,\n  provider TEXT NOT NULL,\n  attempt_id TEXT NOT NULL,\n  state TEXT NOT NULL CHECK(state IN ('dispatch','succeeded','failed','unknown')),\n  lease_token TEXT NOT NULL,\n  lease_expires_at INTEGER NOT NULL,\n  result TEXT CHECK(result IS NULL OR json_valid(result)),\n  failure TEXT CHECK(failure IS NULL OR json_valid(failure)),\n  PRIMARY KEY(namespace, provider, attempt_id),\n  FOREIGN KEY(namespace, provider, attempt_id) REFERENCES admissions(namespace, provider, attempt_id),\n  CHECK((state = 'succeeded' AND result IS NOT NULL AND failure IS NULL) OR (state != 'succeeded' AND result IS NULL))\n) STRICT"
    },
    {
      "type": "table",
      "name": "budgets",
      "tbl_name": "budgets",
      "sql": "CREATE TABLE budgets (\n  id TEXT PRIMARY KEY NOT NULL,\n  maximum TEXT NOT NULL,\n  reserved TEXT NOT NULL DEFAULT '0'\n) STRICT"
    },
    {
      "type": "table",
      "name": "idempotency",
      "tbl_name": "idempotency",
      "sql": "CREATE TABLE idempotency (\n  namespace TEXT NOT NULL,\n  provider TEXT NOT NULL,\n  caller_key TEXT NOT NULL,\n  idempotency_key TEXT NOT NULL,\n  approval_id TEXT NOT NULL REFERENCES approvals(id),\n  attempt_id TEXT NOT NULL,\n  PRIMARY KEY(namespace, provider, caller_key, idempotency_key),\n  FOREIGN KEY(namespace, provider, attempt_id) REFERENCES admissions(namespace, provider, attempt_id)\n) STRICT"
    },
    {
      "type": "table",
      "name": "onboarding_records",
      "tbl_name": "onboarding_records",
      "sql": "CREATE TABLE onboarding_records (\n  collection TEXT NOT NULL,\n  id TEXT NOT NULL,\n  record TEXT NOT NULL CHECK(json_valid(record)),\n  PRIMARY KEY(collection, id)\n) STRICT"
    }
