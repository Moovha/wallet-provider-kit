{
  "configVersion": 1,
  "profile": "provider-service-v1",
  "policy": {
    "version": "1",
    "provider": {
      "name": "Your Wallet Provider",
      "origin": "https://wallet.example.com",
      "privacyUrl": "https://wallet.example.com/privacy"
    },
    "applications": [
      {
        "issuer": "https://applications.example.com",
        "clientId": "your-registered-application-client",
        "name": "Your Connected Application",
        "permissions": ["account:read", "contracts:request"],
        "assertionTrust": {
          "agreement": "your-reviewed-application-trust-agreement"
        }
      }
    ],
    "identity": {
      "maxAgeDays": 90,
      "application": {
        "requiredFields": ["country"],
        "verificationLevel": "verified"
      }
    },
    "access": {
      "maxAgeDays": 7,
      "mode": "application"
    }
  },
  "oauth": {
    "issuer": "https://applications.example.com",
    "audience": "your-wallet-provider",
    "jwksUrl": "https://applications.example.com/jwks"
  },
  "identity": {},
  "backend": {
    "kind": "cdp",
    "apiKeyId": {
      "env": "WALLET_CDP_API_KEY_ID"
    },
    "apiKeySecret": {
      "env": "WALLET_CDP_API_KEY_SECRET"
    },
    "walletSecret": {
      "env": "WALLET_CDP_WALLET_SECRET"
    },
    "binding": "your-stable-cdp-environment"
  },
  "storage": {
    "kind": "sqlite",
    "directory": ".provider-data"
  },
  "activation": {
    "enabled": false
  },
  "http": {
    "host": "127.0.0.1",
    "port": 8080,
    "documentation": false
  },
  "approvedCalls": {
    "maxValiditySeconds": 300,
    "policy": {
      "mechanism": "safe-1.4.1",
      "accounts": [
        {
          "address": "0x1111111111111111111111111111111111111111",
          "codeHash": "0x1111111111111111111111111111111111111111111111111111111111111111",
          "accountId": "10000000-0000-4000-8000-000000000001",
          "singleton": {
            "address": "0x2222222222222222222222222222222222222222",
            "codeHash": "0x1111111111111111111111111111111111111111111111111111111111111111"
          }
        }
      ],
      "multiSend": {
        "address": "0x3333333333333333333333333333333333333333",
        "codeHash": "0x1111111111111111111111111111111111111111111111111111111111111111"
      },
      "maximumNativeValueWei": "0",
      "lifetimeOperations": "100",
      "contracts": [
        {
          "address": "0x4444444444444444444444444444444444444444",
          "codeHash": "0x1111111111111111111111111111111111111111111111111111111111111111",
          "selectors": ["0x12345678"],
          "maximumValueWei": "0"
        }
      ],
      "swaps": [
        {
          "id": "accepted-swap-route",
          "router": {
            "address": "0x5555555555555555555555555555555555555555",
            "codeHash": "0x1111111111111111111111111111111111111111111111111111111111111111"
          },
          "tokenIn": {
            "address": "0x6666666666666666666666666666666666666666",
            "codeHash": "0x1111111111111111111111111111111111111111111111111111111111111111"
          },
          "tokenOut": {
            "address": "0x7777777777777777777777777777777777777777",
            "codeHash": "0x1111111111111111111111111111111111111111111111111111111111111111"
          },
          "fee": 3000,
          "maximumInput": "1000000"
        }
      ],
      "vaults": [
        {
          "id": "accepted-vault-route",
          "router": {
            "address": "0x9999999999999999999999999999999999999999",
            "codeHash": "0x1111111111111111111111111111111111111111111111111111111111111111"
          },
          "vault": {
            "address": "0x8888888888888888888888888888888888888888",
            "codeHash": "0x1111111111111111111111111111111111111111111111111111111111111111"
          },
          "asset": {
            "address": "0x6666666666666666666666666666666666666666",
            "codeHash": "0x1111111111111111111111111111111111111111111111111111111111111111"
          },
          "maximumAssets": "1000000"
        }
      ]
    }
  },
  "execution": {
    "profile": "approved-evm-executor-v1",
    "service": {
      "url": "https://executor.example.com",
      "providerId": "application-sponsor",
      "providerRevision": "1",
      "signing": {
        "id": "wallet-2026",
        "privateKey": {
          "env": "WALLET_SERVICE_PRIVATE_KEY"
        }
      },
      "keys": [
        {
          "id": "executor-2026",
          "publicKey": {
            "env": "EXECUTOR_SERVICE_PUBLIC_KEY"
          }
        }
      ]
    },
    "rpc": {
      "endpoints": [
        {
          "env": "EXECUTION_RPC_PRIMARY_URL"
        },
        {
          "env": "EXECUTION_RPC_SECONDARY_URL"
        }
      ],
      "genesisHash": "0x1111111111111111111111111111111111111111111111111111111111111111"
    },
    "sponsors": [
      {
        "clientId": "your-registered-application-client",
        "accountId": "20000000-0000-4000-8000-000000000002",
        "binding": {
          "address": "0x3333333333333333333333333333333333333333",
          "bindingRevision": "1"
        },
        "fundingAgreement": "your-reviewed-gas-funding-agreement",
        "gasLimit": "150000",
        "maxFeePerGas": "3000000000",
        "maxPriorityFeePerGas": "1000000000",
        "l1FeeReserveWei": "1000000000000",
        "lifetimeBudgetWei": "10000000000000000"
      }
    ],
    "pollIntervalSeconds": 15,
    "maxLogRange": 10000
  }
}
